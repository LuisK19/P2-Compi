package generated;

import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.HashMap;
import src.codigo.EncabezadoFor;
import src.codigo.GeneradorCodigo;
import src.semantico.AnalizadorSemantico;
import src.semantico.ResultadoExpresion;
import src.tabla.SimboloFuncion;
import src.tabla.TablaSimbolos;

/* Código auxiliar del parser: conserva el lexer como fuente de tokens, adapta
 * los errores de CUP para incluir ubicación y lexema, y delega las
 * comprobaciones semánticas en AnalizadorSemantico.
 */
parser code {:
    Lexer analizadorLexico;
    private boolean huboErroresSintacticos = false;
    AnalizadorSemantico semantico = new AnalizadorSemantico();
    GeneradorCodigo generador = new GeneradorCodigo();
    String codigoIntermedio = "";

    public Parser(Lexer analizadorLexico) {
        this.analizadorLexico = analizadorLexico;
    }

    public void report_error(String mensaje, Object infoAdicional) {
        huboErroresSintacticos = true;
        semantico.contarErrorSintactico();
        String textoError = "Error de sintaxis";
        
        if (infoAdicional instanceof Symbol) {
            Symbol token = (Symbol) infoAdicional;
            
            if (token.left >= 0) {
                textoError += " en la linea " + (token.left + 1); 
                
                if (token.right >= 0) {
                    textoError += ", columna " + (token.right + 1);
                }
            }
            
            if (token.value != null) {
                textoError += " [Lexema problematico: '" + token.value + "']";
            }
        }
        
        textoError += " ==> " + mensaje;
        System.err.println(textoError);
    }

    public boolean huboErroresSintacticos() {
        return huboErroresSintacticos;
    }

    public boolean huboErroresSemanticos() {
        return semantico.huboErrores();
    }

    public void setFuncionesDeclaradas(HashMap<String, SimboloFuncion> funcionesDeclaradas) {
        semantico.setFuncionesDeclaradas(funcionesDeclaradas);
    }

    public TablaSimbolos getTablaSimbolos() {
        return semantico.getTablaSimbolos();
    }

    public String getCodigoIntermedio() {
        return codigoIntermedio;
    }

    // Cantidad de tokens que deben leerse bien despues de un error para reportar el siguiente.
    public int error_sync_size() {
        return 1;
    }

    public void report_fatal_error(String mensaje, Object infoAdicional) {
        report_error("ERROR FATAL: " + mensaje, infoAdicional);
    }
:};

scan with {: return analizadorLexico.next_token(); :};
/* Terminales*/

/* Palabras reservadas y tipos de dato. */
terminal VAL, INT, FLOAT, BOOL, CHAR, STR, TRUE, FALSE;
terminal IF, ELIF, ELSE, WHILE, FOR, RETURN, BREAK, WRITE, READ, VOID, PRINCIPAL;

/* Operadores aritméticos y unarios */
terminal OP_SUMA, OP_MENOS, OP_MULT, OP_DIV, OP_DIV_ENT, OP_MOD, OP_POT;
terminal OP_INC, OP_DEC;

/* Operadores Relacionales */
terminal OP_MENOR, OP_MAYOR, OP_MENIG, OP_MAYIG, OP_IGUAL, OP_DIFER;

/* Operadores Logicos */
terminal OP_AND, OP_OR, OP_NOT;

/* Delimitadores y Simbolos Especiales */
terminal LLAVE_ABRE, LLAVE_CIERRA;
terminal CORCHETE_ABRE, CORCHETE_CIERRA;
terminal PARENTESIS_ABRE, PARENTESIS_CIERRA;
terminal ASIGNACION, FIN_SENT, COMA;

/* Tokens con valor */
terminal String ID;
terminal Integer ENTERO;
terminal Double FLOTANTE;
terminal String CADENA;
terminal String CARACTER;

/*No terminales*/
non terminal programa, encabezado_principal;
non terminal encabezado_funcion, params, parametro, param_fun;
non terminal ArrayList<ResultadoExpresion> args;
non terminal inicio_bloque;
non terminal String valor_arreglo_int, valor_arreglo_float;
non terminal ArrayList<String> valores_arreglo_int, valores_arreglo_float;
non terminal apertura_if, apertura_elif, apertura_while, apertura_for;
non terminal String inicio_for, actualizacion_for;
non terminal EncabezadoFor encabezado_for;
non terminal param_write;
non terminal String op_orden, op_igualdad;
non terminal String negativo_int, negativo_float;
non terminal Double literal_float;
non terminal String literal_bool, literal_char, literal_str;

/* No terminales que devuelven un valor para la tabla de símbolos */
non terminal String identificador, tipo;
non terminal Integer literal_int, tamano_arreglo;

/* No terminales que devuelven el resultado de una expresión */
non terminal ResultadoExpresion expresion, expr_log, operacion_log, negacion, operando_log;
non terminal ResultadoExpresion expr_rel, operacion_rel, operando_rel, operando_igualdad;
non terminal ResultadoExpresion expr_arit, term_mul_div, term_sum_res, potencia, atomo;
non terminal ResultadoExpresion acceso_arreglo, incremento, decremento, llamada_fun, negativo, literal;
non terminal ResultadoExpresion condicion;

/* No terminales que devuelven el código intermedio de una sentencia o estructura */
non terminal String globales_opc, funciones_opc, principal, funcion, cuerpo_funcion;
non terminal String declaracion, declaracion_arreglo, asignacion, bloque, lista_lineas, linea_bloque, sentencia;
non terminal String estructura_control, sentencia_if, sentencia_while, sentencia_for;
non terminal String elif_opc, else_opc, sentencia_elif, sentencia_else;
non terminal String sentencia_return, sentencia_break, sentencia_write, sentencia_read;

/* Simbolo inicial */
start with programa;

/* Producciones para identificadores, tipos y valores literales. */

identificador ::= ID:nombre {: RESULT = nombre; :} ;

tipo ::= INT   {: RESULT = "int"; :}
     | FLOAT {: RESULT = "float"; :}
     | BOOL  {: RESULT = "bool"; :}
     | CHAR  {: RESULT = "char"; :}
     | STR   {: RESULT = "string"; :}
     ;

literal ::= literal_int:valor   {: RESULT = parser.generador.cargarEnTemporal("int", String.valueOf(valor)); :}
        | literal_float:valor {: RESULT = parser.generador.cargarEnTemporal("float", GeneradorCodigo.textoFlotante(valor)); :}
        | literal_bool:valor  {: RESULT = parser.generador.cargarEnTemporal("bool", valor); :}
        | literal_char:valor  {: RESULT = parser.generador.cargarEnTemporal("char", "'" + valor + "'"); :}
        | literal_str:valor   {: RESULT = parser.generador.cargarEnTemporal("string", "\"" + valor + "\""); :}
        ;

literal_int   ::= ENTERO:valor    {: RESULT = valor; :} ;
literal_float ::= FLOTANTE:valor  {: RESULT = valor; :} ;
literal_bool  ::= TRUE            {: RESULT = "true"; :}
              | FALSE           {: RESULT = "false"; :}
              ;
literal_char  ::= CARACTER:valor  {: RESULT = valor; :} ;
literal_str   ::= CADENA:valor    {: RESULT = valor; :} ;

valores_arreglo_int ::= valor_arreglo_int:valor
                        {: RESULT = new ArrayList<String>();
                           RESULT.add(valor); :}
                    | valor_arreglo_int:valor COMA valores_arreglo_int:resto
                        {: resto.add(0, valor);
                           RESULT = resto; :}
                    ;

valor_arreglo_int ::= literal_int:valor   {: RESULT = String.valueOf(valor); :}
                  | negativo_int:valor  {: RESULT = valor; :}
                  ;

valores_arreglo_float ::= valor_arreglo_float:valor
                          {: RESULT = new ArrayList<String>();
                             RESULT.add(valor); :}
                      | valor_arreglo_float:valor COMA valores_arreglo_float:resto
                          {: resto.add(0, valor);
                             RESULT = resto; :}
                      ;

valor_arreglo_float ::= literal_float:valor   {: RESULT = GeneradorCodigo.textoFlotante(valor); :}
                    | negativo_float:valor  {: RESULT = valor; :}
                    ;

declaracion ::= VAL tipo:tipoDato identificador:nombre FIN_SENT
                {: parser.semantico.agregarSimbolo(nombre, "variable", tipoDato, nombreleft, nombreright);
                   RESULT = parser.generador.valorInicial(nombre, tipoDato); :}
            | VAL tipo:tipoDato identificador:nombre ASIGNACION:asig expresion:valor FIN_SENT
                {: parser.semantico.validarAsignacion(nombre, tipoDato, valor, asigleft, asigright);
                   parser.semantico.agregarSimbolo(nombre, "variable", tipoDato, nombreleft, nombreright);
                   RESULT = parser.generador.asignacion(nombre, valor); :}
            ;

declaracion_arreglo ::= VAL tipo:tipoDato identificador:nombre tamano_arreglo:tamano FIN_SENT
                        {: parser.semantico.validarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           parser.semantico.agregarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           RESULT = parser.generador.valoresIniciales(nombre, tipoDato, tamano, new ArrayList<String>()); :}
                    | VAL tipo:tipoDato identificador:nombre tamano_arreglo:tamano ASIGNACION LLAVE_ABRE valores_arreglo_int:valores LLAVE_CIERRA FIN_SENT
                        {: parser.semantico.validarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           parser.semantico.validarValoresArreglo(nombre, tipoDato, tamano, "int", valores.size(), nombreleft, nombreright);
                           parser.semantico.agregarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           RESULT = parser.generador.valoresIniciales(nombre, tipoDato, tamano, valores); :}
                    | VAL tipo:tipoDato identificador:nombre tamano_arreglo:tamano ASIGNACION LLAVE_ABRE valores_arreglo_float:valores LLAVE_CIERRA FIN_SENT
                        {: parser.semantico.validarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           parser.semantico.validarValoresArreglo(nombre, tipoDato, tamano, "float", valores.size(), nombreleft, nombreright);
                           parser.semantico.agregarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           RESULT = parser.generador.valoresIniciales(nombre, tipoDato, tamano, valores); :}
                    ;

tamano_arreglo ::= CORCHETE_ABRE literal_int:tamano CORCHETE_CIERRA {: RESULT = tamano; :} ;

asignacion ::= identificador:nombre ASIGNACION:asig expresion:valor FIN_SENT
                {: String tipoDestino = parser.semantico.tipoDeVariable(nombre, nombreleft, nombreright);
                   parser.semantico.validarAsignacion(nombre, tipoDestino, valor, asigleft, asigright);
                   RESULT = parser.generador.asignacion(nombre, valor); :}
           | identificador:nombre CORCHETE_ABRE:corchete expr_arit:indice CORCHETE_CIERRA ASIGNACION:asig expresion:valor FIN_SENT
                {: String tipoDestino = parser.semantico.tipoDeArreglo(nombre, nombreleft, nombreright);
                   parser.semantico.validarIndice(indice, corcheteleft, corcheteright);
                   parser.semantico.validarAsignacion(nombre, tipoDestino, valor, asigleft, asigright);
                   RESULT = parser.generador.asignacionElemento(nombre, indice, valor); :}
           ;

expresion ::= expr_log:valor {: RESULT = valor; :} ;

expr_log ::= operacion_log:valor {: RESULT = valor; :}
         | expr_rel:valor        {: RESULT = valor; :}
         ;

operacion_log ::= operando_log:izquierdo OP_AND:op operando_log:derecho
                    {: String tipo = parser.semantico.operacionLogica("λ", izquierdo, derecho, opleft, opright).getTipo();
                       RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "λ", derecho); :}
              | operando_log:izquierdo OP_OR:op operando_log:derecho
                    {: String tipo = parser.semantico.operacionLogica("θ", izquierdo, derecho, opleft, opright).getTipo();
                       RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "θ", derecho); :}
              | negacion:valor
                    {: RESULT = valor; :}
              ;

negacion ::= OP_NOT:op operando_log:operando
                {: String tipo = parser.semantico.negacionLogica(operando, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionUnaria(tipo, "Σ", operando); :}
         ;

operando_log ::= PARENTESIS_ABRE expresion:valor PARENTESIS_CIERRA {: RESULT = valor; :}
             | negacion:valor                                      {: RESULT = valor; :}
             ;

expr_rel ::= operacion_rel:valor {: RESULT = valor; :}
         | expr_arit:valor       {: RESULT = valor; :}
         ;

operacion_rel ::= operando_rel:izquierdo op_orden:op operando_rel:derecho
                    {: String tipo = parser.semantico.operacionRelacional(op, izquierdo, derecho, opleft, opright).getTipo();
                       RESULT = parser.generador.operacionBinaria(tipo, izquierdo, op, derecho); :}
              | operando_igualdad:izquierdo op_igualdad:op operando_igualdad:derecho
                    {: String tipo = parser.semantico.operacionRelacional(op, izquierdo, derecho, opleft, opright).getTipo();
                       RESULT = parser.generador.operacionBinaria(tipo, izquierdo, op, derecho); :}
              ;

operando_rel ::= CORCHETE_ABRE expr_arit:valor CORCHETE_CIERRA {: RESULT = valor; :} ;

operando_igualdad ::= operando_rel:valor                                  {: RESULT = valor; :}
                  | CORCHETE_ABRE operacion_rel:valor CORCHETE_CIERRA     {: RESULT = valor; :}
                  | CORCHETE_ABRE operacion_log:valor CORCHETE_CIERRA     {: RESULT = valor; :}
                  ;

op_orden ::= OP_MENOR {: RESULT = "<"; :}
         | OP_MAYOR  {: RESULT = ">"; :}
         | OP_MENIG  {: RESULT = "<="; :}
         | OP_MAYIG  {: RESULT = ">="; :}
         ;

op_igualdad ::= OP_IGUAL {: RESULT = "=="; :}
            | OP_DIFER   {: RESULT = "!="; :}
            ;

expr_arit ::= term_mul_div:valor
                {: RESULT = valor; :}
          | expr_arit:izquierdo OP_MOD:op term_mul_div:derecho
                {: String tipo = parser.semantico.operacionAritmetica("mod", izquierdo, derecho, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "mod", derecho); :}
          ;

term_mul_div ::= term_sum_res:valor
                {: RESULT = valor; :}
             | term_mul_div:izquierdo OP_MULT:op term_sum_res:derecho
                {: String tipo = parser.semantico.operacionAritmetica("*", izquierdo, derecho, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "*", derecho); :}
             | term_mul_div:izquierdo OP_DIV:op term_sum_res:derecho
                {: String tipo = parser.semantico.operacionAritmetica("/", izquierdo, derecho, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "/", derecho); :}
             | term_mul_div:izquierdo OP_DIV_ENT:op term_sum_res:derecho
                {: String tipo = parser.semantico.operacionAritmetica("//", izquierdo, derecho, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "//", derecho); :}
             ;

term_sum_res ::= potencia:valor
                {: RESULT = valor; :}
             | term_sum_res:izquierdo OP_SUMA:op potencia:derecho
                {: String tipo = parser.semantico.operacionAritmetica("+", izquierdo, derecho, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "+", derecho); :}
             | term_sum_res:izquierdo OP_MENOS:op potencia:derecho
                {: String tipo = parser.semantico.operacionAritmetica("-", izquierdo, derecho, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionBinaria(tipo, izquierdo, "-", derecho); :}
             ;

potencia ::= atomo:valor
                {: RESULT = valor; :}
         | atomo:base OP_POT:op potencia:exponente
                {: String tipo = parser.semantico.operacionPotencia(base, exponente, opleft, opright).getTipo();
                   RESULT = parser.generador.operacionBinaria(tipo, base, "pot", exponente); :}
         ;

atomo ::= literal:valor                                     {: RESULT = valor; :}
      | identificador:nombre
            {: String tipo = parser.semantico.tipoDeVariable(nombre, nombreleft, nombreright);
               RESULT = parser.generador.cargarEnTemporal(tipo, nombre); :}
      | PARENTESIS_ABRE expresion:valor PARENTESIS_CIERRA   {: RESULT = valor; :}
      | negativo:valor                                      {: RESULT = valor; :}
      | incremento:valor                                    {: RESULT = valor; :}
      | decremento:valor                                    {: RESULT = valor; :}
      | llamada_fun:valor                                   {: RESULT = valor; :}
      | acceso_arreglo:valor                                {: RESULT = valor; :}
      ;

acceso_arreglo ::= identificador:nombre CORCHETE_ABRE:corchete expr_arit:indice CORCHETE_CIERRA
                   {: parser.semantico.validarIndice(indice, corcheteleft, corcheteright);
                      String tipo = parser.semantico.tipoDeArreglo(nombre, nombreleft, nombreright);
                      RESULT = parser.generador.accesoArreglo(tipo, nombre, indice); :}
               ;

negativo ::= negativo_int:valor
                {: RESULT = parser.generador.cargarEnTemporal("int", valor);
                   RESULT.marcarLiteralNegativo(); :}
         | negativo_float:valor
                {: RESULT = parser.generador.cargarEnTemporal("float", valor);
                   RESULT.marcarLiteralNegativo(); :}
         ;

negativo_int ::= OP_MENOS literal_int:valor      {: RESULT = "-" + valor; :} ;
negativo_float ::= OP_MENOS literal_float:valor  {: RESULT = "-" + GeneradorCodigo.textoFlotante(valor); :} ;

incremento ::= identificador:nombre OP_INC
                {: String tipo = parser.semantico.operacionIncremento("++", nombre, nombreleft, nombreright).getTipo();
                   RESULT = parser.generador.incremento(tipo, nombre, "+"); :}
           ;
decremento ::= identificador:nombre OP_DEC
                {: String tipo = parser.semantico.operacionIncremento("--", nombre, nombreleft, nombreright).getTipo();
                   RESULT = parser.generador.incremento(tipo, nombre, "-"); :}
           ;

sentencia ::= declaracion:codigo           {: RESULT = codigo; :}
          | declaracion_arreglo:codigo     {: RESULT = codigo; :}
          | asignacion:codigo              {: RESULT = codigo; :}
          | incremento:valor FIN_SENT      {: RESULT = valor.getCodigo(); :}
          | decremento:valor FIN_SENT      {: RESULT = valor.getCodigo(); :}
          | llamada_fun FIN_SENT           {: RESULT = ""; :}
          | sentencia_write:codigo         {: RESULT = codigo; :}
          | sentencia_read:codigo          {: RESULT = codigo; :}
          | sentencia_return:codigo        {: RESULT = codigo; :}
          | sentencia_break:codigo         {: RESULT = codigo; :}
          ;

condicion ::= PARENTESIS_ABRE:parentesis expresion:valor PARENTESIS_CIERRA
                {: parser.semantico.validarCondicion(valor, parentesisleft, parentesisright);
                   RESULT = valor; :}
          | PARENTESIS_ABRE error PARENTESIS_CIERRA
                {: RESULT = new ResultadoExpresion(ResultadoExpresion.TIPO_ERROR); :}
          ;

sentencia_if ::= apertura_if condicion:condicion bloque:cuerpo elif_opc:ramasElif else_opc:cuerpoElse
                 {: RESULT = parser.generador.sentenciaIf(condicion, cuerpo, ramasElif, cuerpoElse); :}
             ;

apertura_if ::= IF {: parser.generador.abrirIf(); :} ;

elif_opc ::= sentencia_elif:codigo elif_opc:resto   {: RESULT = codigo + resto; :}
         |                                        {: RESULT = ""; :}
         ;

else_opc ::= sentencia_else:codigo   {: RESULT = codigo; :}
         |                         {: RESULT = ""; :}
         ;

sentencia_elif ::= apertura_elif condicion:condicion bloque:cuerpo
                   {: RESULT = parser.generador.ramaElif(condicion, cuerpo); :}
               ;

apertura_elif ::= ELIF {: parser.generador.abrirElif(); :} ;
sentencia_else ::= ELSE bloque:codigo    {: RESULT = codigo; :} ;

bloque ::= inicio_bloque lista_lineas:codigo LLAVE_CIERRA
                {: parser.semantico.cerrarAlcance();
                   RESULT = codigo; :}
       | inicio_bloque error LLAVE_CIERRA
                {: parser.semantico.cerrarAlcance();
                   RESULT = ""; :}
       ;

inicio_bloque ::= LLAVE_ABRE:llave {: parser.semantico.abrirAlcance("bloque linea " + (llaveleft + 1)); :} ;

lista_lineas ::= linea_bloque:codigo                      {: RESULT = codigo; :}
             | linea_bloque:codigo lista_lineas:resto     {: RESULT = codigo + resto; :}
             ;

linea_bloque ::= sentencia:codigo              {: RESULT = codigo; :}
             | estructura_control:codigo       {: RESULT = codigo; :}
             | bloque:codigo                   {: RESULT = codigo; :}
             | error FIN_SENT                  {: RESULT = ""; :}
             | error bloque                    {: RESULT = ""; :}
             ;

estructura_control ::= sentencia_if:codigo     {: RESULT = codigo; :}
                   | sentencia_while:codigo    {: RESULT = codigo; :}
                   | sentencia_for:codigo      {: RESULT = codigo; :}
                   ;

sentencia_while ::= apertura_while condicion:condicion bloque:cuerpo
                    {: parser.semantico.salirDeCiclo();
                       RESULT = parser.generador.sentenciaWhile(condicion, cuerpo); :}
                ;

apertura_while ::= WHILE
                   {: parser.semantico.entrarACiclo();
                      parser.generador.abrirWhile(); :}
               ;

sentencia_for ::= apertura_for encabezado_for:encabezado bloque:cuerpo
                  {: parser.semantico.salirDeCiclo();
                     parser.semantico.cerrarAlcance();
                     RESULT = parser.generador.sentenciaFor(encabezado, cuerpo); :}
              ;

apertura_for ::= FOR:palabraFor
                 {: parser.semantico.entrarACiclo();
                    parser.semantico.abrirAlcance("for linea " + (palabraForleft + 1));
                    parser.generador.abrirFor(); :}
             ;

encabezado_for ::= PARENTESIS_ABRE inicio_for:inicio expresion:valor FIN_SENT:fin actualizacion_for:actualizacion PARENTESIS_CIERRA
                   {: parser.semantico.validarCondicion(valor, finleft, finright);
                      RESULT = new EncabezadoFor(inicio, valor, actualizacion); :}
               ;

inicio_for ::= declaracion:codigo   {: RESULT = codigo; :}
           | asignacion:codigo    {: RESULT = codigo; :}
           ;

actualizacion_for ::= expresion:valor
                    {: RESULT = valor.getCodigo(); :}
                  | identificador:nombre ASIGNACION:asig expresion:valor
                    {: String tipoDestino = parser.semantico.tipoDeVariable(nombre, nombreleft, nombreright);
                       parser.semantico.validarAsignacion(nombre, tipoDestino, valor, asigleft, asigright);
                       RESULT = parser.generador.asignacion(nombre, valor); :}
                  ;

sentencia_return ::= RETURN:palabraReturn expresion:valor FIN_SENT
                     {: parser.semantico.validarReturn(valor, palabraReturnleft, palabraReturnright);
                        RESULT = ""; :}
                 ;
sentencia_break ::= BREAK:palabraBreak FIN_SENT
                    {: parser.semantico.validarBreak(palabraBreakleft, palabraBreakright);
                       RESULT = ""; :}
                ;

sentencia_write ::= WRITE PARENTESIS_ABRE param_write PARENTESIS_CIERRA FIN_SENT {: RESULT = ""; :} ;

param_write ::= literal_str
            | literal_int
            | literal_bool
            | literal_float
            | negativo
            | identificador:nombre
                {: String tipo = parser.semantico.tipoDeVariable(nombre, nombreleft, nombreright);
                   parser.semantico.validarTipoWrite(nombre, tipo, nombreleft, nombreright); :}
            | acceso_arreglo
            ;

sentencia_read ::= READ PARENTESIS_ABRE identificador:nombre PARENTESIS_CIERRA FIN_SENT
                   {: String tipo = parser.semantico.tipoDeVariable(nombre, nombreleft, nombreright);
                      parser.semantico.validarTipoRead(nombre, tipo, nombreleft, nombreright);
                      RESULT = ""; :}
               ;

funcion ::= encabezado_funcion param_fun cuerpo_funcion:cuerpo
                {: parser.semantico.validarFuncionConReturn();
                   parser.semantico.cerrarAlcance();
                   RESULT = cuerpo; :}
        | encabezado_funcion error cuerpo_funcion:cuerpo
                {: parser.semantico.validarFuncionConReturn();
                   parser.semantico.cerrarAlcance();
                   RESULT = cuerpo; :}
        ;

encabezado_funcion ::= tipo:tipoRetorno identificador:nombre
                       {: parser.semantico.validarTipoRetorno(nombre, tipoRetorno, nombreleft, nombreright);
                          parser.semantico.agregarFuncion(nombre, tipoRetorno, nombreleft, nombreright);
                          parser.semantico.abrirAlcance(nombre); :}
                   ;

cuerpo_funcion ::= LLAVE_ABRE lista_lineas:codigo LLAVE_CIERRA  {: RESULT = codigo; :}
               | LLAVE_ABRE error LLAVE_CIERRA                {: RESULT = ""; :}
               ;

params ::= parametro
       | parametro COMA params
       ;

parametro ::= tipo:tipoDato identificador:nombre
              {: parser.semantico.agregarSimbolo(nombre, "parametro", tipoDato, nombreleft, nombreright);
                 parser.semantico.agregarTipoParametro(tipoDato); :}
          ;

param_fun ::= PARENTESIS_ABRE params PARENTESIS_CIERRA
          | PARENTESIS_ABRE PARENTESIS_CIERRA
          ;

llamada_fun ::= identificador:nombre PARENTESIS_ABRE args:argumentos PARENTESIS_CIERRA
                {: RESULT = parser.semantico.llamadaFuncion(nombre, argumentos, nombreleft, nombreright); :}
            | identificador:nombre PARENTESIS_ABRE PARENTESIS_CIERRA
                {: RESULT = parser.semantico.llamadaFuncion(nombre, new ArrayList<ResultadoExpresion>(), nombreleft, nombreright); :}
            ;

args ::= expresion:valor
            {: RESULT = new ArrayList<ResultadoExpresion>();
               RESULT.add(valor); :}
     | expresion:valor COMA args:resto
            {: resto.add(0, valor);
               RESULT = resto; :}
     ;

principal ::= encabezado_principal cuerpo_funcion:cuerpo
                {: parser.semantico.cerrarAlcance();
                   RESULT = cuerpo; :}
          ;

encabezado_principal ::= VOID PRINCIPAL:palabraPrincipal PARENTESIS_ABRE PARENTESIS_CIERRA
                         {: parser.semantico.agregarFuncion("principal", "void", palabraPrincipalleft, palabraPrincipalright);
                            parser.semantico.abrirAlcance("principal"); :}
                     ;

globales_opc ::= declaracion:codigo globales_opc:resto           {: RESULT = codigo + resto; :}
             | declaracion_arreglo:codigo globales_opc:resto   {: RESULT = codigo + resto; :}
             | error FIN_SENT globales_opc:resto               {: RESULT = resto; :}
             |                                                 {: RESULT = ""; :}
             ;

funciones_opc ::= funcion:codigo funciones_opc:resto  {: RESULT = codigo + resto; :}
              |                                       {: RESULT = ""; :}
              ;

programa ::= globales_opc:globales funciones_opc:funcionesAntes principal:codigoPrincipal funciones_opc:funcionesDespues
             {: parser.codigoIntermedio = globales + funcionesAntes + codigoPrincipal + funcionesDespues; :}
         ;
