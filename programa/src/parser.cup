package generated;

import java_cup.runtime.*;

/* Código auxiliar del parser: conserva el lexer como fuente de tokens y adapta
 * los errores de CUP para incluir ubicación y lexema 
 */
parser code {:
    Lexer analizadorLexico;
    private boolean huboErroresSintacticos = false;

    public Parser(Lexer analizadorLexico) {
        this.analizadorLexico = analizadorLexico;
    }

    public void report_error(String mensaje, Object infoAdicional) {
        huboErroresSintacticos = true;
        String textoError = "Error de sintaxis";
        
        if (infoAdicional instanceof java_cup.runtime.Symbol) {
            java_cup.runtime.Symbol token = (java_cup.runtime.Symbol) infoAdicional;
            
            if (token.left >= 0) {
                textoError += " en la linea " + (token.left + 1); 
                
                if (token.right >= 0) {
                    textoError += ", columna " + (token.right + 1);
                }
            }
            
            if (token.value != null) {
                textoError += " [Lexema problematico: '" + token.value + "']";
            }
        }
        
        textoError += " ==> " + mensaje;
        System.err.println(textoError);
    }

    public boolean huboErroresSintacticos() {
        return huboErroresSintacticos;
    }

    public void report_fatal_error(String mensaje, Object infoAdicional) {
        report_error("ERROR FATAL: " + mensaje, infoAdicional);
    }
:};

scan with {: return analizadorLexico.next_token(); :};
/* Terminales*/

/* Palabras reservadas y tipos de dato. */
terminal VAL, INT, FLOAT, BOOL, CHAR, STR, TRUE, FALSE;
terminal IF, ELIF, ELSE, WHILE, FOR, RETURN, BREAK, WRITE, READ, VOID, PRINCIPAL;

/* Operadores aritméticos y unarios */
terminal OP_SUMA, OP_MENOS, OP_MULT, OP_DIV, OP_DIV_ENT, OP_MOD, OP_POT;
terminal OP_INC, OP_DEC;

/* Operadores Relacionales */
terminal OP_MENOR, OP_MAYOR, OP_MENIG, OP_MAYIG, OP_IGUAL, OP_DIFER;

/* Operadores Logicos */
terminal OP_AND, OP_OR, OP_NOT;

/* Delimitadores y Simbolos Especiales */
terminal LLAVE_ABRE, LLAVE_CIERRA;
terminal CORCHETE_ABRE, CORCHETE_CIERRA;
terminal PARENTESIS_ABRE, PARENTESIS_CIERRA;
terminal ASIGNACION, FIN_SENT, COMA;

/* Tokens con valor */
terminal String ID;
terminal Integer ENTERO;
terminal Double FLOTANTE;
terminal String CADENA;
terminal String CARACTER;

/*No terminales*/
non terminal programa, globales_opc, funciones_opc, principal;
non terminal funcion, tipo_retorno, params, param_fun, llamada_fun, args;
non terminal declaracion, declaracion_arreglo, asignacion, bloque, lista_lineas, linea_bloque, sentencia;
non terminal tamano_arreglo, valores_arreglo_int, valor_arreglo_int, valores_arreglo_float, valor_arreglo_float;
non terminal estructura_control, sentencia_if, elif_opc, else_opc, sentencia_elif, sentencia_else;
non terminal sentencia_while, sentencia_for, encabezado_for, condicion;
non terminal sentencia_return, sentencia_break, sentencia_write, param_write, sentencia_read;
non terminal expresion, expr_log, operacion_log, operando_log;
non terminal expr_rel, operacion_rel, operando_rel, operando_igualdad, op_orden, op_igualdad;
non terminal expr_arit, term_mul_div, term_sum_res, potencia, atomo, acceso_arreglo, incremento, decremento;
non terminal negativo, negativo_int, negativo_float;
non terminal identificador, tipo, literal, literal_int, literal_float, literal_bool, literal_char, literal_str;

/* Simbolo inicial */
start with programa;

/* Producciones para identificadores, tipos y valores literales. */

identificador ::= ID ;

tipo ::= INT | FLOAT | BOOL | CHAR | STR ;

literal ::= literal_int
        | literal_float
        | literal_bool
        | literal_char
        | literal_str
        ;

literal_int   ::= ENTERO ;
literal_float ::= FLOTANTE ;
literal_bool  ::= TRUE | FALSE ;
literal_char  ::= CARACTER ;
literal_str   ::= CADENA ;

valores_arreglo_int ::= valor_arreglo_int
                    | valor_arreglo_int COMA valores_arreglo_int
                    ;

valor_arreglo_int ::= literal_int
                  | negativo_int
                  ;

valores_arreglo_float ::= valor_arreglo_float
                      | valor_arreglo_float COMA valores_arreglo_float
                      ;

valor_arreglo_float ::= literal_float
                    | negativo_float
                    ;

declaracion ::= VAL tipo identificador FIN_SENT
            | VAL tipo identificador ASIGNACION expresion FIN_SENT
            ;

declaracion_arreglo ::= VAL tipo identificador tamano_arreglo FIN_SENT
                    | VAL tipo identificador tamano_arreglo ASIGNACION LLAVE_ABRE valores_arreglo_int LLAVE_CIERRA FIN_SENT
                    | VAL tipo identificador tamano_arreglo ASIGNACION LLAVE_ABRE valores_arreglo_float LLAVE_CIERRA FIN_SENT
                    ;

tamano_arreglo ::= CORCHETE_ABRE literal_int CORCHETE_CIERRA ;

asignacion ::= identificador ASIGNACION expresion FIN_SENT
           | identificador CORCHETE_ABRE expr_arit CORCHETE_CIERRA ASIGNACION expresion FIN_SENT
           ;

expresion ::= expr_log ;

expr_log ::= operacion_log
         | expr_rel
         ;

operacion_log ::= operando_log OP_AND operando_log
              | operando_log OP_OR operando_log
              | OP_NOT operando_log
              ;

operando_log ::= PARENTESIS_ABRE expr_arit PARENTESIS_CIERRA
             | PARENTESIS_ABRE operacion_rel PARENTESIS_CIERRA
             | PARENTESIS_ABRE operacion_log PARENTESIS_CIERRA
             ;

expr_rel ::= operacion_rel
         | expr_arit
         ;

operacion_rel ::= operando_rel op_orden operando_rel
              | operando_igualdad op_igualdad operando_igualdad
              ;

operando_rel ::= CORCHETE_ABRE expr_arit CORCHETE_CIERRA ;

operando_igualdad ::= operando_rel
                  | CORCHETE_ABRE operacion_rel CORCHETE_CIERRA
                  | CORCHETE_ABRE operacion_log CORCHETE_CIERRA
                  ;

op_orden ::= OP_MENOR | OP_MAYOR | OP_MENIG | OP_MAYIG ;

op_igualdad ::= OP_IGUAL | OP_DIFER ;

expr_arit ::= term_mul_div
          | expr_arit OP_MOD term_mul_div
          ;

term_mul_div ::= term_sum_res
             | term_mul_div OP_MULT term_sum_res
             | term_mul_div OP_DIV term_sum_res
             | term_mul_div OP_DIV_ENT term_sum_res
             ;

term_sum_res ::= potencia
             | term_sum_res OP_SUMA potencia
             | term_sum_res OP_MENOS potencia
             ;

potencia ::= atomo
         | potencia OP_POT atomo
         ;

atomo ::= literal
      | identificador
      | PARENTESIS_ABRE expr_arit PARENTESIS_CIERRA
      | negativo
      | incremento
      | decremento
      | llamada_fun
      | acceso_arreglo
      ;

acceso_arreglo ::= identificador CORCHETE_ABRE expr_arit CORCHETE_CIERRA ;

negativo ::= negativo_int
         | negativo_float
         ;

negativo_int ::= OP_MENOS literal_int ;
negativo_float ::= OP_MENOS literal_float ;

incremento ::= identificador OP_INC ;
decremento ::= identificador OP_DEC ;

sentencia ::= declaracion
          | declaracion_arreglo
          | asignacion
          | incremento FIN_SENT
          | decremento FIN_SENT
          | llamada_fun FIN_SENT
          | sentencia_write
          | sentencia_read
          | sentencia_return
          | sentencia_break
          ;

condicion ::= PARENTESIS_ABRE expresion PARENTESIS_CIERRA ;

sentencia_if ::= IF condicion bloque elif_opc else_opc ;

elif_opc ::= sentencia_elif elif_opc
         | 
         ;

else_opc ::= sentencia_else
         |
         ;

sentencia_elif ::= ELIF condicion bloque ;
sentencia_else ::= ELSE bloque ;

bloque ::= LLAVE_ABRE lista_lineas LLAVE_CIERRA
       | LLAVE_ABRE error LLAVE_CIERRA
       ;

lista_lineas ::= linea_bloque
             | linea_bloque lista_lineas
             ;

linea_bloque ::= sentencia
             | estructura_control
             | bloque
             | error FIN_SENT
             ;

estructura_control ::= sentencia_if
                   | sentencia_while
                   | sentencia_for
                   ;

sentencia_while ::= WHILE condicion bloque ;

sentencia_for ::= FOR encabezado_for bloque ;

encabezado_for ::= declaracion COMA condicion COMA sentencia ;

sentencia_return ::= RETURN expresion FIN_SENT ;
sentencia_break ::= BREAK FIN_SENT ;

sentencia_write ::= WRITE PARENTESIS_ABRE param_write PARENTESIS_CIERRA FIN_SENT ;

param_write ::= literal_str
            | literal_int
            | literal_bool
            | literal_float
            | identificador
            ;

sentencia_read ::= READ PARENTESIS_ABRE identificador PARENTESIS_CIERRA FIN_SENT ;

funcion ::= tipo_retorno identificador param_fun bloque ;

tipo_retorno ::= INT | FLOAT | CHAR | BOOL ;

params ::= tipo identificador
       | tipo identificador COMA params
       ;

param_fun ::= PARENTESIS_ABRE params PARENTESIS_CIERRA
          | PARENTESIS_ABRE PARENTESIS_CIERRA
          ;

llamada_fun ::= identificador PARENTESIS_ABRE args PARENTESIS_CIERRA
            | identificador PARENTESIS_ABRE PARENTESIS_CIERRA
            ;

args ::= expresion
     | expresion COMA args
     ;

principal ::= VOID PRINCIPAL bloque ;

globales_opc ::= declaracion globales_opc
             | declaracion_arreglo globales_opc
             |
             ;

funciones_opc ::= funcion funciones_opc
              |
              ;

programa ::= globales_opc funciones_opc principal;
