package generated;

import java_cup.runtime.*;
import src.ResultadoExpresion;
import src.Simbolo;
import src.SimboloArreglo;
import src.SimboloFuncion;
import src.TablaSimbolos;

/* Código auxiliar del parser: conserva el lexer como fuente de tokens, adapta
 * los errores de CUP para incluir ubicación y lexema, y guarda la tabla de símbolos
 */
parser code {:
    Lexer analizadorLexico;
    private boolean huboErroresSintacticos = false;
    private boolean huboErroresSemanticos = false;
    TablaSimbolos tabla = new TablaSimbolos();
    SimboloFuncion funcionActual;

    public Parser(Lexer analizadorLexico) {
        this.analizadorLexico = analizadorLexico;
    }

    public void report_error(String mensaje, Object infoAdicional) {
        huboErroresSintacticos = true;
        String textoError = "Error de sintaxis";
        
        if (infoAdicional instanceof Symbol) {
            Symbol token = (Symbol) infoAdicional;
            
            if (token.left >= 0) {
                textoError += " en la linea " + (token.left + 1); 
                
                if (token.right >= 0) {
                    textoError += ", columna " + (token.right + 1);
                }
            }
            
            if (token.value != null) {
                textoError += " [Lexema problematico: '" + token.value + "']";
            }
        }
        
        textoError += " ==> " + mensaje;
        System.err.println(textoError);
    }

    public boolean huboErroresSintacticos() {
        return huboErroresSintacticos;
    }

    public boolean huboErroresSemanticos() {
        return huboErroresSemanticos;
    }

    public TablaSimbolos getTablaSimbolos() {
        return tabla;
    }

    String tipoDeSimbolo(String nombre) {
        Simbolo simbolo = tabla.buscar(nombre);
        if (simbolo == null) {
            return ResultadoExpresion.TIPO_ERROR;
        }
        return simbolo.getTipo();
    }

    // En los metodos siguientes la linea y columna llegan desde 0; se muestran y guardan desde 1.
    void reportarErrorSemantico(String mensaje, int linea, int columna) {
        huboErroresSemanticos = true;
        System.err.println("Error semantico en la linea " + (linea + 1)
                + ", columna " + (columna + 1) + ": " + mensaje);
    }

    Simbolo buscarDeclarado(String nombre, int linea, int columna) {
        Simbolo simbolo = tabla.buscar(nombre);
        if (simbolo == null) {
            reportarErrorSemantico("el identificador '" + nombre + "' no ha sido declarado", linea, columna);
        }
        return simbolo;
    }

    String tipoDeVariable(String nombre, int linea, int columna) {
        Simbolo simbolo = buscarDeclarado(nombre, linea, columna);
        if (simbolo == null) {
            return ResultadoExpresion.TIPO_ERROR;
        }
        if (simbolo.getCategoria().equals("arreglo")) {
            reportarErrorSemantico("el arreglo '" + nombre + "' debe usarse con un indice", linea, columna);
            return ResultadoExpresion.TIPO_ERROR;
        }
        if (simbolo.getCategoria().equals("funcion")) {
            reportarErrorSemantico("'" + nombre + "' es una funcion y no puede usarse como variable", linea, columna);
            return ResultadoExpresion.TIPO_ERROR;
        }
        return simbolo.getTipo();
    }

    String tipoDeArreglo(String nombre, int linea, int columna) {
        Simbolo simbolo = buscarDeclarado(nombre, linea, columna);
        if (simbolo == null) {
            return ResultadoExpresion.TIPO_ERROR;
        }
        if (!simbolo.getCategoria().equals("arreglo")) {
            reportarErrorSemantico("'" + nombre + "' no es un arreglo", linea, columna);
            return ResultadoExpresion.TIPO_ERROR;
        }
        return simbolo.getTipo();
    }

    boolean aceptaTipoAritmetico(String operador, String tipo) {
        if (operador.equals("/")) {
            return tipo.equals("float");
        }
        if (operador.equals("//") || operador.equals("mod") || operador.equals("pot")) {
            return tipo.equals("int");
        }
        return tipo.equals("int") || tipo.equals("float");
    }

    boolean aceptaTipoRelacional(String operador, String tipo) {
        if (operador.equals("==") || operador.equals("!=")) {
            return tipo.equals("int") || tipo.equals("float") || tipo.equals("bool") || tipo.equals("char");
        }
        return tipo.equals("int") || tipo.equals("float");
    }

    ResultadoExpresion errorDeOperandos(String operador, ResultadoExpresion izquierdo,
            ResultadoExpresion derecho, int linea, int columna) {
        reportarErrorSemantico("el operador '" + operador + "' no acepta operandos de tipo "
                + izquierdo.getTipo() + " y " + derecho.getTipo(), linea, columna);
        return new ResultadoExpresion(ResultadoExpresion.TIPO_ERROR);
    }

    ResultadoExpresion operacionAritmetica(String operador, ResultadoExpresion izquierdo,
            ResultadoExpresion derecho, int linea, int columna) {
        if (izquierdo.esError() || derecho.esError()) {
            return new ResultadoExpresion(ResultadoExpresion.TIPO_ERROR);
        }
        String tipo = izquierdo.getTipo();
        if (!tipo.equals(derecho.getTipo()) || !aceptaTipoAritmetico(operador, tipo)) {
            return errorDeOperandos(operador, izquierdo, derecho, linea, columna);
        }
        return new ResultadoExpresion(tipo);
    }

    ResultadoExpresion operacionRelacional(String operador, ResultadoExpresion izquierdo,
            ResultadoExpresion derecho, int linea, int columna) {
        if (izquierdo.esError() || derecho.esError()) {
            return new ResultadoExpresion(ResultadoExpresion.TIPO_ERROR);
        }
        String tipo = izquierdo.getTipo();
        if (!tipo.equals(derecho.getTipo()) || !aceptaTipoRelacional(operador, tipo)) {
            return errorDeOperandos(operador, izquierdo, derecho, linea, columna);
        }
        return new ResultadoExpresion("bool");
    }

    ResultadoExpresion operacionPotencia(ResultadoExpresion base, ResultadoExpresion exponente,
            int linea, int columna) {
        ResultadoExpresion resultado = operacionAritmetica("pot", base, exponente, linea, columna);
        if (!resultado.esError() && exponente.esLiteralNegativo()) {
            reportarErrorSemantico("el exponente de 'pot' no puede ser negativo", linea, columna);
            return new ResultadoExpresion(ResultadoExpresion.TIPO_ERROR);
        }
        return resultado;
    }

    boolean esTipoDeArreglo(String tipo) {
        return tipo.equals("int") || tipo.equals("float");
    }

    void validarArreglo(String nombre, String tipo, int tamano, int linea, int columna) {
        if (!esTipoDeArreglo(tipo)) {
            reportarErrorSemantico("el arreglo '" + nombre + "' solo puede ser de tipo int o float", linea, columna);
        }
        if (tamano <= 0) {
            reportarErrorSemantico("el tamano del arreglo '" + nombre + "' debe ser mayor que 0", linea, columna);
        }
    }

    void validarValoresArreglo(String nombre, String tipo, int tamano, String tipoValores, int cantidad,
            int linea, int columna) {
        if (esTipoDeArreglo(tipo) && !tipo.equals(tipoValores)) {
            reportarErrorSemantico("el arreglo '" + nombre + "' es de tipo " + tipo
                    + " pero sus valores son de tipo " + tipoValores, linea, columna);
        }
        if (tamano > 0 && cantidad != tamano) {
            reportarErrorSemantico("el arreglo '" + nombre + "' tiene tamano " + tamano
                    + " pero recibe " + cantidad + " valores", linea, columna);
        }
    }

    boolean estaDuplicado(String nombre, int linea, int columna) {
        if (tabla.buscarEnAlcanceActual(nombre) == null) {
            return false;
        }
        reportarErrorSemantico("el identificador '" + nombre + "' ya fue declarado en este alcance", linea, columna);
        return true;
    }

    void agregarSimbolo(String nombre, String categoria, String tipo, int linea, int columna) {
        if (!estaDuplicado(nombre, linea, columna)) {
            tabla.agregar(new Simbolo(nombre, categoria, tipo, linea + 1, columna + 1));
        }
    }

    void agregarArreglo(String nombre, String tipo, int tamano, int linea, int columna) {
        if (!estaDuplicado(nombre, linea, columna)) {
            tabla.agregar(new SimboloArreglo(nombre, tipo, tamano, linea + 1, columna + 1));
        }
    }

    void agregarFuncion(String nombre, String tipoRetorno, int linea, int columna) {
        funcionActual = new SimboloFuncion(nombre, tipoRetorno, linea + 1, columna + 1);
        if (!estaDuplicado(nombre, linea, columna)) {
            tabla.agregar(funcionActual);
        }
    }

    // Cantidad de tokens que deben leerse bien despues de un error para reportar el siguiente.
    public int error_sync_size() {
        return 1;
    }

    public void report_fatal_error(String mensaje, Object infoAdicional) {
        report_error("ERROR FATAL: " + mensaje, infoAdicional);
    }
:};

scan with {: return analizadorLexico.next_token(); :};
/* Terminales*/

/* Palabras reservadas y tipos de dato. */
terminal VAL, INT, FLOAT, BOOL, CHAR, STR, TRUE, FALSE;
terminal IF, ELIF, ELSE, WHILE, FOR, RETURN, BREAK, WRITE, READ, VOID, PRINCIPAL;

/* Operadores aritméticos y unarios */
terminal OP_SUMA, OP_MENOS, OP_MULT, OP_DIV, OP_DIV_ENT, OP_MOD, OP_POT;
terminal OP_INC, OP_DEC;

/* Operadores Relacionales */
terminal OP_MENOR, OP_MAYOR, OP_MENIG, OP_MAYIG, OP_IGUAL, OP_DIFER;

/* Operadores Logicos */
terminal OP_AND, OP_OR, OP_NOT;

/* Delimitadores y Simbolos Especiales */
terminal LLAVE_ABRE, LLAVE_CIERRA;
terminal CORCHETE_ABRE, CORCHETE_CIERRA;
terminal PARENTESIS_ABRE, PARENTESIS_CIERRA;
terminal ASIGNACION, FIN_SENT, COMA;

/* Tokens con valor */
terminal String ID;
terminal Integer ENTERO;
terminal Double FLOTANTE;
terminal String CADENA;
terminal String CARACTER;

/*No terminales*/
non terminal programa, globales_opc, funciones_opc, principal, encabezado_principal;
non terminal funcion, encabezado_funcion, cuerpo_funcion, params, parametro, param_fun, args;
non terminal declaracion, declaracion_arreglo, asignacion, bloque, inicio_bloque, lista_lineas, linea_bloque, sentencia;
non terminal valor_arreglo_int, valor_arreglo_float;
non terminal estructura_control, sentencia_if, elif_opc, else_opc, sentencia_elif, sentencia_else;
non terminal sentencia_while, sentencia_for, apertura_for, encabezado_for, inicio_for, actualizacion_for, condicion;
non terminal sentencia_return, sentencia_break, sentencia_write, param_write, sentencia_read;
non terminal String op_orden, op_igualdad;
non terminal negativo_int, negativo_float;
non terminal literal_float, literal_bool, literal_char, literal_str;

/* No terminales que devuelven un valor para la tabla de símbolos */
non terminal String identificador, tipo;
non terminal Integer literal_int, tamano_arreglo, valores_arreglo_int, valores_arreglo_float;

/* No terminales que devuelven el resultado de una expresión */
non terminal ResultadoExpresion expresion, expr_log, operacion_log, negacion, operando_log;
non terminal ResultadoExpresion expr_rel, operacion_rel, operando_rel, operando_igualdad;
non terminal ResultadoExpresion expr_arit, term_mul_div, term_sum_res, potencia, atomo;
non terminal ResultadoExpresion acceso_arreglo, incremento, decremento, llamada_fun, negativo, literal;

/* Simbolo inicial */
start with programa;

/* Producciones para identificadores, tipos y valores literales. */

identificador ::= ID:nombre {: RESULT = nombre; :} ;

tipo ::= INT   {: RESULT = "int"; :}
     | FLOAT {: RESULT = "float"; :}
     | BOOL  {: RESULT = "bool"; :}
     | CHAR  {: RESULT = "char"; :}
     | STR   {: RESULT = "string"; :}
     ;

literal ::= literal_int   {: RESULT = new ResultadoExpresion("int"); :}
        | literal_float {: RESULT = new ResultadoExpresion("float"); :}
        | literal_bool  {: RESULT = new ResultadoExpresion("bool"); :}
        | literal_char  {: RESULT = new ResultadoExpresion("char"); :}
        | literal_str   {: RESULT = new ResultadoExpresion("string"); :}
        ;

literal_int   ::= ENTERO:valor {: RESULT = valor; :} ;
literal_float ::= FLOTANTE ;
literal_bool  ::= TRUE | FALSE ;
literal_char  ::= CARACTER ;
literal_str   ::= CADENA ;

valores_arreglo_int ::= valor_arreglo_int                                   {: RESULT = 1; :}
                    | valor_arreglo_int COMA valores_arreglo_int:cantidad   {: RESULT = cantidad + 1; :}
                    ;

valor_arreglo_int ::= literal_int
                  | negativo_int
                  ;

valores_arreglo_float ::= valor_arreglo_float                                     {: RESULT = 1; :}
                      | valor_arreglo_float COMA valores_arreglo_float:cantidad   {: RESULT = cantidad + 1; :}
                      ;

valor_arreglo_float ::= literal_float
                    | negativo_float
                    ;

declaracion ::= VAL tipo:tipoDato identificador:nombre FIN_SENT
                {: parser.agregarSimbolo(nombre, "variable", tipoDato, nombreleft, nombreright); :}
            | VAL tipo:tipoDato identificador:nombre ASIGNACION expresion FIN_SENT
                {: parser.agregarSimbolo(nombre, "variable", tipoDato, nombreleft, nombreright); :}
            ;

declaracion_arreglo ::= VAL tipo:tipoDato identificador:nombre tamano_arreglo:tamano FIN_SENT
                        {: parser.validarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           parser.agregarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright); :}
                    | VAL tipo:tipoDato identificador:nombre tamano_arreglo:tamano ASIGNACION LLAVE_ABRE valores_arreglo_int:cantidad LLAVE_CIERRA FIN_SENT
                        {: parser.validarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           parser.validarValoresArreglo(nombre, tipoDato, tamano, "int", cantidad, nombreleft, nombreright);
                           parser.agregarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright); :}
                    | VAL tipo:tipoDato identificador:nombre tamano_arreglo:tamano ASIGNACION LLAVE_ABRE valores_arreglo_float:cantidad LLAVE_CIERRA FIN_SENT
                        {: parser.validarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright);
                           parser.validarValoresArreglo(nombre, tipoDato, tamano, "float", cantidad, nombreleft, nombreright);
                           parser.agregarArreglo(nombre, tipoDato, tamano, nombreleft, nombreright); :}
                    ;

tamano_arreglo ::= CORCHETE_ABRE literal_int:tamano CORCHETE_CIERRA {: RESULT = tamano; :} ;

asignacion ::= identificador:nombre ASIGNACION expresion FIN_SENT
                {: parser.tipoDeVariable(nombre, nombreleft, nombreright); :}
           | identificador:nombre CORCHETE_ABRE expr_arit CORCHETE_CIERRA ASIGNACION expresion FIN_SENT
                {: parser.tipoDeArreglo(nombre, nombreleft, nombreright); :}
           ;

expresion ::= expr_log:valor {: RESULT = valor; :} ;

expr_log ::= operacion_log:valor {: RESULT = valor; :}
         | expr_rel:valor        {: RESULT = valor; :}
         ;

operacion_log ::= operando_log OP_AND operando_log {: RESULT = new ResultadoExpresion("bool"); :}
              | operando_log OP_OR operando_log    {: RESULT = new ResultadoExpresion("bool"); :}
              | negacion:valor                     {: RESULT = valor; :}
              ;

negacion ::= OP_NOT operando_log {: RESULT = new ResultadoExpresion("bool"); :} ;

operando_log ::= PARENTESIS_ABRE expresion:valor PARENTESIS_CIERRA {: RESULT = valor; :}
             | negacion:valor                                      {: RESULT = valor; :}
             ;

expr_rel ::= operacion_rel:valor {: RESULT = valor; :}
         | expr_arit:valor       {: RESULT = valor; :}
         ;

operacion_rel ::= operando_rel:izquierdo op_orden:op operando_rel:derecho
                    {: RESULT = parser.operacionRelacional(op, izquierdo, derecho, opleft, opright); :}
              | operando_igualdad:izquierdo op_igualdad:op operando_igualdad:derecho
                    {: RESULT = parser.operacionRelacional(op, izquierdo, derecho, opleft, opright); :}
              ;

operando_rel ::= CORCHETE_ABRE expr_arit:valor CORCHETE_CIERRA {: RESULT = valor; :} ;

operando_igualdad ::= operando_rel:valor                                  {: RESULT = valor; :}
                  | CORCHETE_ABRE operacion_rel:valor CORCHETE_CIERRA     {: RESULT = valor; :}
                  | CORCHETE_ABRE operacion_log:valor CORCHETE_CIERRA     {: RESULT = valor; :}
                  ;

op_orden ::= OP_MENOR {: RESULT = "<"; :}
         | OP_MAYOR  {: RESULT = ">"; :}
         | OP_MENIG  {: RESULT = "<="; :}
         | OP_MAYIG  {: RESULT = ">="; :}
         ;

op_igualdad ::= OP_IGUAL {: RESULT = "=="; :}
            | OP_DIFER   {: RESULT = "!="; :}
            ;

expr_arit ::= term_mul_div:valor
                {: RESULT = valor; :}
          | expr_arit:izquierdo OP_MOD:op term_mul_div:derecho
                {: RESULT = parser.operacionAritmetica("mod", izquierdo, derecho, opleft, opright); :}
          ;

term_mul_div ::= term_sum_res:valor
                {: RESULT = valor; :}
             | term_mul_div:izquierdo OP_MULT:op term_sum_res:derecho
                {: RESULT = parser.operacionAritmetica("*", izquierdo, derecho, opleft, opright); :}
             | term_mul_div:izquierdo OP_DIV:op term_sum_res:derecho
                {: RESULT = parser.operacionAritmetica("/", izquierdo, derecho, opleft, opright); :}
             | term_mul_div:izquierdo OP_DIV_ENT:op term_sum_res:derecho
                {: RESULT = parser.operacionAritmetica("//", izquierdo, derecho, opleft, opright); :}
             ;

term_sum_res ::= potencia:valor
                {: RESULT = valor; :}
             | term_sum_res:izquierdo OP_SUMA:op potencia:derecho
                {: RESULT = parser.operacionAritmetica("+", izquierdo, derecho, opleft, opright); :}
             | term_sum_res:izquierdo OP_MENOS:op potencia:derecho
                {: RESULT = parser.operacionAritmetica("-", izquierdo, derecho, opleft, opright); :}
             ;

potencia ::= atomo:valor
                {: RESULT = valor; :}
         | atomo:base OP_POT:op potencia:exponente
                {: RESULT = parser.operacionPotencia(base, exponente, opleft, opright); :}
         ;

atomo ::= literal:valor                                     {: RESULT = valor; :}
      | identificador:nombre                                {: RESULT = new ResultadoExpresion(parser.tipoDeVariable(nombre, nombreleft, nombreright)); :}
      | PARENTESIS_ABRE expresion:valor PARENTESIS_CIERRA   {: RESULT = valor; :}
      | negativo:valor                                      {: RESULT = valor; :}
      | incremento:valor                                    {: RESULT = valor; :}
      | decremento:valor                                    {: RESULT = valor; :}
      | llamada_fun:valor                                   {: RESULT = valor; :}
      | acceso_arreglo:valor                                {: RESULT = valor; :}
      ;

acceso_arreglo ::= identificador:nombre CORCHETE_ABRE expr_arit CORCHETE_CIERRA
                   {: RESULT = new ResultadoExpresion(parser.tipoDeArreglo(nombre, nombreleft, nombreright)); :}
               ;

negativo ::= negativo_int
                {: RESULT = new ResultadoExpresion("int");
                   RESULT.marcarLiteralNegativo(); :}
         | negativo_float
                {: RESULT = new ResultadoExpresion("float");
                   RESULT.marcarLiteralNegativo(); :}
         ;

negativo_int ::= OP_MENOS literal_int ;
negativo_float ::= OP_MENOS literal_float ;

incremento ::= identificador:nombre OP_INC {: RESULT = new ResultadoExpresion(parser.tipoDeVariable(nombre, nombreleft, nombreright)); :} ;
decremento ::= identificador:nombre OP_DEC {: RESULT = new ResultadoExpresion(parser.tipoDeVariable(nombre, nombreleft, nombreright)); :} ;

sentencia ::= declaracion
          | declaracion_arreglo
          | asignacion
          | incremento FIN_SENT
          | decremento FIN_SENT
          | llamada_fun FIN_SENT
          | sentencia_write
          | sentencia_read
          | sentencia_return
          | sentencia_break
          ;

condicion ::= PARENTESIS_ABRE expresion PARENTESIS_CIERRA
          | PARENTESIS_ABRE error PARENTESIS_CIERRA
          ;

sentencia_if ::= IF condicion bloque elif_opc else_opc ;

elif_opc ::= sentencia_elif elif_opc
         | 
         ;

else_opc ::= sentencia_else
         |
         ;

sentencia_elif ::= ELIF condicion bloque ;
sentencia_else ::= ELSE bloque ;

bloque ::= inicio_bloque lista_lineas LLAVE_CIERRA {: parser.tabla.cerrarAlcance(); :}
       | inicio_bloque error LLAVE_CIERRA {: parser.tabla.cerrarAlcance(); :}
       ;

inicio_bloque ::= LLAVE_ABRE:llave {: parser.tabla.abrirAlcance("bloque linea " + (llaveleft + 1)); :} ;

lista_lineas ::= linea_bloque
             | linea_bloque lista_lineas
             ;

linea_bloque ::= sentencia
             | estructura_control
             | bloque
             | error FIN_SENT
             | error bloque
             ;

estructura_control ::= sentencia_if
                   | sentencia_while
                   | sentencia_for
                   ;

sentencia_while ::= WHILE condicion bloque ;

sentencia_for ::= apertura_for encabezado_for bloque {: parser.tabla.cerrarAlcance(); :} ;

apertura_for ::= FOR:palabraFor {: parser.tabla.abrirAlcance("for linea " + (palabraForleft + 1)); :} ;

encabezado_for ::= PARENTESIS_ABRE inicio_for expresion FIN_SENT actualizacion_for PARENTESIS_CIERRA ;

inicio_for ::= declaracion
           | asignacion
           ;

actualizacion_for ::= expresion
                  | identificador:nombre ASIGNACION expresion
                    {: parser.tipoDeVariable(nombre, nombreleft, nombreright); :}
                  ;

sentencia_return ::= RETURN expresion FIN_SENT ;
sentencia_break ::= BREAK FIN_SENT ;

sentencia_write ::= WRITE PARENTESIS_ABRE param_write PARENTESIS_CIERRA FIN_SENT ;

param_write ::= literal_str
            | literal_int
            | literal_bool
            | literal_float
            | negativo
            | identificador:nombre {: parser.tipoDeVariable(nombre, nombreleft, nombreright); :}
            | acceso_arreglo
            ;

sentencia_read ::= READ PARENTESIS_ABRE identificador:nombre PARENTESIS_CIERRA FIN_SENT
                   {: parser.tipoDeVariable(nombre, nombreleft, nombreright); :}
               ;

funcion ::= encabezado_funcion param_fun cuerpo_funcion {: parser.tabla.cerrarAlcance(); :}
        | encabezado_funcion error cuerpo_funcion {: parser.tabla.cerrarAlcance(); :}
        ;

encabezado_funcion ::= tipo:tipoRetorno identificador:nombre
                       {: parser.agregarFuncion(nombre, tipoRetorno, nombreleft, nombreright);
                          parser.tabla.abrirAlcance(nombre); :}
                   ;

cuerpo_funcion ::= LLAVE_ABRE lista_lineas LLAVE_CIERRA
               | LLAVE_ABRE error LLAVE_CIERRA
               ;

params ::= parametro
       | parametro COMA params
       ;

parametro ::= tipo:tipoDato identificador:nombre
              {: parser.agregarSimbolo(nombre, "parametro", tipoDato, nombreleft, nombreright);
                 parser.funcionActual.agregarTipoParametro(tipoDato); :}
          ;

param_fun ::= PARENTESIS_ABRE params PARENTESIS_CIERRA
          | PARENTESIS_ABRE PARENTESIS_CIERRA
          ;

llamada_fun ::= identificador:nombre PARENTESIS_ABRE args PARENTESIS_CIERRA
                {: RESULT = new ResultadoExpresion(parser.tipoDeSimbolo(nombre)); :}
            | identificador:nombre PARENTESIS_ABRE PARENTESIS_CIERRA
                {: RESULT = new ResultadoExpresion(parser.tipoDeSimbolo(nombre)); :}
            ;

args ::= expresion
     | expresion COMA args
     ;

principal ::= encabezado_principal cuerpo_funcion {: parser.tabla.cerrarAlcance(); :} ;

encabezado_principal ::= VOID PRINCIPAL:palabraPrincipal PARENTESIS_ABRE PARENTESIS_CIERRA
                         {: parser.agregarFuncion("principal", "void", palabraPrincipalleft, palabraPrincipalright);
                            parser.tabla.abrirAlcance("principal"); :}
                     ;

globales_opc ::= declaracion globales_opc
             | declaracion_arreglo globales_opc
             | error FIN_SENT globales_opc
             |
             ;

funciones_opc ::= funcion funciones_opc
              |
              ;

programa ::= globales_opc funciones_opc principal funciones_opc ;
